/*================================================================================
1. File Descriptions:
================================================================================
W634GU8QB.modelsim.vp                       - protected Verilog model file by modelsim 
Config-AC.v                   - AC parameters file

	  
================================================================================  
|================================================================================    
|Verilog compiler directive "`define" usage
|================================================================================
|1. Defining the Speed Grade:
|Using verilog compiler directive "`define" to choose speed grades, allowable speed 
|grades are listed in the Config-AC.v file and begin with the letters "T".  The 
|speed grade is used to select a set of timing parameters for the ddr3 model.  
|
|T9 : DDR3-2133, 1066Mhz|
|T11: DDR3-1866, 933Mhz|
|T12: DDR3-1600, 800Mhz
|T15: DDR3-1333, 667Mhz
|
|
|
|
|================================================================================        
|Verilog command
|================================================================================
|  
|    $ ncverilog  +access+rwc +sv +define+T12 W634GU8QB.modelsim.vp yourtestfile
|    
**********************************************************************************************/


// DO NOT CHANGE THE TIMESCALE
// MAKE SURE YOUR SIMULATOR USES "PS" RESOLUTION
`timescale 1ps / 1ps



`define DP   //down speed     : DP, NDP  
`define ODT2   //odt out types  : ODT2, ODT4

`define DSPH   //display hierachy
//`define WEC_DIS_INFO
//`define WEC_DIS_ERR
//`define WEC_DIS_WARN




// model flags
//`define MAX_MEM
//

//`define MEM_INIT    //to open this define if you want to preload the memory data


//-------------------------------------------------------------
                        // pin definition
module W634GU8QB (           // x16                  x8
//-------------------------------------------------------------
    reset_n,            // RESET#               RESET#
    ck,                 // CK                   CK
    ck_n,               // CK#                  CK#
    cke,                // CKE                  CKE
    cs_n,               // CS#                  CS#
    ras_n,              // RAS#                 RAS#
    cas_n,              // CAS#                 CAS#
    we_n,               // WE#                  WE#
    dm_tdqs,            // DMU, DML             DM/TDQS
    ba,                 // BA[2:0]              BA[2:0]
    addr,               
    dq,                 // DQU[7:0],DQL[7:0]    DQ[7:0]
    dqs,                // DQSU,  DQSL          DQS
    dqs_n,              // DQSU#, DQSL#         DQS#    
    odt                 // ODT                  ODT
);

    `include "Config-AC.v"

   
 

    // Declare Ports
    input   reset_n;
    input   ck;
    input   ck_n;
    input   cke;
    input   cs_n;
    input   ras_n;
    input   cas_n;
    input   we_n;
    inout   [DM_BITS-1:0]   dm_tdqs;
    input   [BA_BITS-1:0]   ba;
    input   [ADDR_BITS-1:0] addr;
    inout   [DQ_BITS-1:0]   dq;
    inout   [DQS_BITS-1:0]  dqs;
    inout   [DQS_BITS-1:0]  dqs_n;
    input   odt;

    	
// 
